#!/usr/bin/env php
<?php

declare(strict_types=1);

use Asmpkg\Guiche\Cli\Application;

$autoload = $_composer_autoload_path
    ?? dirname(__DIR__) . '/vendor/autoload.php';

if (!is_file($autoload)) {
    fwrite(
        STDERR,
        "Guichê: vendor/autoload.php não encontrado. Execute Composer primeiro." . PHP_EOL
    );
    exit(1);
}

require $autoload;

$projectRoot = getcwd();

if ($projectRoot === false) {
    fwrite(STDERR, "Guichê: não foi possível determinar o diretório atual." . PHP_EOL);
    exit(1);
}

exit(
    (new Application(
        dirname(__DIR__),
        $projectRoot
    ))->run($argv)
);
