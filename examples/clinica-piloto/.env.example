# Guichê v0.8 — Clinical Example
# O exemplo inicia em Fake Mode e não acessa serviços externos.
GUICHE_CLINICAL_MODE=fake

GUICHE_TIMEZONE=America/Sao_Paulo
GUICHE_CLINIC_COMPANY_ID=1
GUICHE_CLINIC_NAME="Clínica Exemplo"
GUICHE_FAKE_FIXTURE=

# IA — necessário somente em real mode.
AI_API_KEY=
AI_MODEL=gpt-5.6-luna

# Banco — necessário somente em real mode.
DB_DRIVER=mysql
DB_DSN=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Procedures — ajuste conforme o sistema integrado em real mode.
DB_PROCEDURE_CONSULTAR_PACIENTE=
DB_PROCEDURE_DISPONIBILIDADE_CONVENIOS=profissionais_por_tratamento
DB_PROCEDURE_CONSULTAR_PROFISSIONAL=sp_consulta_profissional
DB_PROCEDURE_CONSULTAR_HORARIOS=horarios_disponiveis_por_turno

# API de escrita — necessário somente em real mode.
GUICHE_AGENDAMENTO_API_URL=
GUICHE_AGENDAMENTO_API_TOKEN=
GUICHE_AGENDAMENTO_API_TIMEOUT=15

GUICHE_HORARIOS_POR_DATA=3
GUICHE_HISTORY_MESSAGES_LIMIT=8
GUICHE_DEBUG=false
