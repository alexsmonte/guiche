{
    "name": "asmpkg/guiche",
    "description": "Core PHP para assistentes conversacionais orientados a Tools, Plugins, estado, segurança, persistência e runtime de conversação.",
    "type": "library",
    "autoload": {
        "psr-4": {
            "Asmpkg\\Guiche\\": "src/"
        }
    },
    "require": {
        "php": "^8.4"
    },
    "autoload-dev": {
        "psr-4": {
            "Asmpkg\\Guiche\\Tests\\": "tests/",
            "GuicheExample\\ClinicaPiloto\\": "examples/clinica-piloto/src/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "phpstan/phpstan": "^2.2"
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:contracts": "phpunit --testsuite contracts",
        "test:integration": "phpunit --testsuite integration",
        "test:legacy": "@php bin/test-v051-acceptance.php",
        "check": [
            "@test",
            "@analyse",
            "@coverage",
            "@test:legacy"
        ],
        "analyse": "phpstan analyse --configuration=phpstan.neon --no-progress",
        "coverage": "@php tools/run-coverage.php",
        "coverage:check": "@php tools/check-coverage.php coverage/clover.xml 70.00"
    },
    "keywords": [
        "ai",
        "conversational-ai",
        "agents",
        "tools",
        "plugins",
        "php"
    ],
    "homepage": "https://github.com/alexsmonte/guiche",
    "support": {
        "issues": "https://github.com/alexsmonte/guiche/issues",
        "source": "https://github.com/alexsmonte/guiche"
    },
    "archive": {
        "exclude": [
            "/storage/",
            "/coverage/",
            "/.phpunit.cache/",
            "/.phpunit.result.cache",
            "/vendor/",
            "/guiche-v*.sh"
        ]
    },
    "license": "MIT"
}
