/vendor/
/.env

/storage/backups/
/storage/examples/
/storage/conversations/*
!/storage/conversations/.gitkeep
/storage/logs/*
!/storage/logs/.gitkeep

# Scripts de desenvolvimento, diagnóstico e testes do piloto
/bin/*
!/bin/chat.php

# Ainda não fazem parte da versão publicada
/index.php
/README.md

# Arquivos locais de editor/sistema
/.idea/
/.vscode/
.DS_Store
Thumbs.db
*.log
/.user.ini

# Documentação interna de planejamento
/docs/

# Testes automatizados
/.phpunit.cache/
/.phpunit.result.cache
/coverage/

# Static analysis
/.phpstan-cache/

# BEGIN GUICHE PUBLIC PACKAGE FILES
# Public DX files required in releases/packages.
!/README.md
!/docs/
/docs/*
!/docs/quick-start.md
!/docs/architecture.md
!/docs/tools.md
!/docs/plugins.md
!/docs/state.md
!/docs/security.md
!/examples/
!/examples/basic/
!/examples/basic/README.md
!/examples/neutral-plugin/
!/examples/neutral-plugin/README.md
# END GUICHE PUBLIC PACKAGE FILES
/.env.local
/.env.production
/.env.development
/.env.test

/dist/
