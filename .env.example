# ============================================================
# GUICHÊ
# ============================================================

GUICHE_TIMEZONE=America/Sao_Paulo
GUICHE_DEBUG=false
GUICHE_SESSION_ID=guiche-cli

# ============================================================
# IA
# ============================================================

AI_API_KEY=
AI_MODEL=gpt-5.6-luna

# Prompt do agente.
# Prioridade:
# 1. GUICHE_PROMPT_FILE
# 2. GUICHE_PROMPT
# 3. guiche.prompt.md na raiz do projeto
# 4. prompt padrão do pacote
GUICHE_PROMPT_FILE=
GUICHE_PROMPT=

# ============================================================
# BANCO DE DADOS
# ============================================================

DB_DRIVER=mysql

# Opcional. Se informado, DB_DSN tem prioridade sobre
# host, porta, database e charset.
DB_DSN=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
